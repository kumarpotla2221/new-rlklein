# ============================================================
# new.rlklein.com: preview site (public_html/new.rlklein.com/.htaccess)
# Uploaded automatically by GitHub Actions. Edit this file in Git, not on the server.
#
# ON SWAP DAY (moving to rlklein.com): use deploy/main-domain/.htaccess instead.
# That version has no "hide from Google" rule and uses the main domain.
# ============================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # This folder sits inside WordPress's public_html, so it is also reachable as
    # rlklein.com/new.rlklein.com/… Send every such visit to the real address.
    RewriteCond %{HTTP_HOST} !^new\.rlklein\.com$ [NC]
    RewriteRule ^(.*)$ https://new.rlklein.com/$1 [R=301,L]

    # Real files and folders (assets, images, api/) are served as they are.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Every other address is a page of the React app (e.g. /jobs/nurse-sacramento).
    RewriteRule ^ index.html [L]
</IfModule>

# Hidden files (e.g. the upload tool's .ftp-deploy-sync-state.json) are never served.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # PREVIEW ONLY: keep new.rlklein.com out of Google until it replaces rlklein.com.
    Header always set X-Robots-Tag "noindex, nofollow"

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Built files have a content hash in their name, so browsers may keep them for a year.
    <FilesMatch "\.(js|css|woff2?|ttf|svg|png|jpe?g|webp|gif|ico|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # The page shell must always be fresh so visitors get new versions right away.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
